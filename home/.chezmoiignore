README.md

{{ if not .isMac }}
.config/homebrew
{{ end }}

{{/* Desktop bits: Alacritty config on macOS / Linux desktops; on WSL the terminal runs on
     Windows, so its files are generated under .config/dotfiles-windows and copied over. */}}
{{ if not (and .isDesktop (not .isWSL)) }}
.config/alacritty
{{ end }}
{{ if not (and .isDesktop .isWSL) }}
.config/dotfiles-windows
{{ end }}
{{ if not (and .isDesktop (eq .chezmoi.os "linux")) }}
.local/share/fonts/MesloNerdFont
{{ end }}

{{ if .isContainer }}
# host-only: the devbox launcher and container-engine integration
.local/bin/devbox
.config/zsh/container-engine.zsh
.config/mise/conf.d/container-engine.toml
{{ else }}
# container-only: entrypoint helper
.local/bin/devbox-init
{{ end }}

{{ if not .hostToolsets }}
.config/mise/conf.d/toolsets.toml
{{ end }}

{{/* Toolset-specific configs: always in containers, on hosts only with that toolset */}}
{{ if not (or .isContainer (has "clojure" .hostToolsets)) }}
.lein
.shadow-cljs
{{ end }}
{{ if not (or .isContainer (has "k8s" .hostToolsets)) }}
.config/k9s
{{ end }}
