{{- /* Environment detection */ -}}
{{- $isMac := eq .chezmoi.os "darwin" -}}
{{- $isWSL := false -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") -}}
{{-   if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-     $isWSL = true -}}
{{-   end -}}
{{- end -}}
{{- $isContainer := false -}}
{{- if or (stat "/.dockerenv") (stat "/run/.containerenv") (env "REMOTE_CONTAINERS") (env "CODESPACES") (env "DEVBOX") -}}
{{-   $isContainer = true -}}
{{- end -}}
{{- $isCI := ne (env "CI") "" -}}

{{- /* Git identity: prompted once on hosts; containers get it at runtime from the host */ -}}
{{- $interactive := and stdinIsATTY (not $isContainer) -}}
{{- $name := "" -}}
{{- $email := "" -}}
{{- if $interactive -}}
{{-   $name = promptStringOnce . "name" "Git user.name" -}}
{{-   $email = promptStringOnce . "email" "Git user.email" -}}
{{- else -}}
{{-   $name = env "GIT_USER_NAME" | default (get . "name" | default "") -}}
{{-   $email = env "GIT_USER_EMAIL" | default (get . "email" | default "") -}}
{{- end -}}

{{- /* Host-wide toolsets (see .chezmoidata/toolsets.toml). Projects normally pick their own via `toolset add`. */ -}}
{{- /* Names are validated in dot_config/mise/conf.d/toolsets.toml.tmpl (.chezmoidata is not available here). */ -}}
{{- $toolsetsSpec := env "DOTFILES_TOOLSETS" -}}
{{- if not $toolsetsSpec -}}
{{-   if $interactive -}}
{{-     $toolsetsSpec = promptStringOnce . "hostToolsetsSpec" "Toolsets to install globally on this host (comma-separated: node,python,java,kotlin,clojure,k8s,aws,shell; empty = none)" "" -}}
{{-   else -}}
{{-     $toolsetsSpec = get . "hostToolsetsSpec" | default "" -}}
{{-   end -}}
{{- end -}}
{{- $hostToolsets := $toolsetsSpec | replace " " "" | splitList "," | compact -}}

{{- /* Container engine for this host */ -}}
{{- $engines := list "podman" "docker" -}}
{{- $engine := env "DOTFILES_CONTAINER_ENGINE" -}}
{{- if not $engine -}}
{{-   if $interactive -}}
{{-     $engine = promptChoiceOnce . "containerEngine" "Container engine" $engines "podman" -}}
{{-   else -}}
{{-     $engine = get . "containerEngine" | default "podman" -}}
{{-   end -}}
{{- end -}}
{{- if not (has $engine $engines) -}}
{{-   fail (printf "containerEngine must be podman or docker, got %q" $engine) -}}
{{- end -}}

{{- /* Color theme (keep in sync with .chezmoidata/themes.toml). Switch later with `theme set <name>`. */ -}}
{{- $themes := list "tokyonight-storm" "nord" "catppuccin-mocha" -}}
{{- $theme := env "DOTFILES_THEME" -}}
{{- if not $theme -}}
{{-   if $interactive -}}
{{-     $theme = promptChoiceOnce . "theme" "Color theme" $themes "tokyonight-storm" -}}
{{-   else -}}
{{-     $theme = get . "theme" | default "tokyonight-storm" -}}
{{-   end -}}
{{- end -}}
{{- if not (has $theme $themes) -}}
{{-   fail (printf "theme must be one of %s, got %q" ($themes | join ", ") $theme) -}}
{{- end -}}

{{- /* Desktop: GUI apps, fonts and the terminal emulator. macOS and WSL (Windows side) always;
       plain Linux asks, defaulting to whether a graphical session is running. */ -}}
{{- $isDesktop := or $isMac $isWSL -}}
{{- if env "DOTFILES_DESKTOP" -}}
{{-   $isDesktop = eq (env "DOTFILES_DESKTOP") "1" -}}
{{- else if or $isContainer $isCI -}}
{{-   $isDesktop = false -}}
{{- else if and (eq .chezmoi.os "linux") (not $isWSL) -}}
{{-   $hasGUI := ne (or (env "XDG_CURRENT_DESKTOP") (env "WAYLAND_DISPLAY") (env "DISPLAY")) "" -}}
{{-   if $interactive -}}
{{-     $isDesktop = promptBoolOnce . "isDesktop" "Desktop machine (GUI apps, fonts, Alacritty)" $hasGUI -}}
{{-   else if hasKey . "isDesktop" -}}
{{-     $isDesktop = get . "isDesktop" -}}   {{- /* not `default`: it would treat a stored false as unset */ -}}
{{-   else -}}
{{-     $isDesktop = $hasGUI -}}
{{-   end -}}
{{- end -}}

# Remember where the dotfiles live, also when installed from a local checkout (DOTFILES_SOURCE)
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    hostToolsetsSpec = {{ $toolsetsSpec | quote }}
    hostToolsets = {{ $hostToolsets | toJson }}
    containerEngine = {{ $engine | quote }}
    theme = {{ $theme | quote }}
    isDesktop = {{ $isDesktop }}
    isMac = {{ $isMac }}
    isWSL = {{ $isWSL }}
    isContainer = {{ $isContainer }}
    isCI = {{ $isCI }}
