{{- $t := index .themes .theme -}}
{{- $c := $t.colors -}}
# Theme: {{ $t.title }} (generated by chezmoi; change with `theme set <name>`)
export COLOR_THEME={{ .theme | quote }}   # for tools configured outside this repo (e.g. nvim); not DOTFILES_THEME, which overrides chezmoi init
export BAT_THEME={{ $t.bat | quote }}
export FZF_DEFAULT_OPTS="--color=fg:{{ $c.fg }},bg:-1,hl:{{ $c.accent }},fg+:{{ $c.fg }},bg+:{{ $c.bg_sel }},hl+:{{ $c.accent }},info:{{ $c.accent_alt }},prompt:{{ $c.accent }},pointer:{{ $c.accent_alt }},marker:{{ $c.normal.green }},spinner:{{ $c.accent_alt }},header:{{ $c.fg_dim }},border:{{ $c.fg_dim }}"
