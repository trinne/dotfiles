{{- $t := index .themes .theme -}}
{{- $c := $t.colors -}}
{{- $n := $c.normal -}}
# k9s skin: {{ $t.title }} (generated by chezmoi; change with `theme set <name>`)
k9s:
  body:
    fgColor: "{{ $c.fg }}"
    bgColor: default
    logoColor: "{{ $c.accent_alt }}"
  prompt:
    fgColor: "{{ $c.fg }}"
    bgColor: default
    suggestColor: "{{ $c.fg_dim }}"
  info:
    fgColor: "{{ $c.accent }}"
    sectionColor: "{{ $c.fg }}"
  dialog:
    fgColor: "{{ $c.fg }}"
    bgColor: default
    buttonFgColor: "{{ $c.bg }}"
    buttonBgColor: "{{ $c.accent_alt }}"
    buttonFocusFgColor: "{{ $c.bg }}"
    buttonFocusBgColor: "{{ $c.accent }}"
    labelFgColor: "{{ $n.yellow }}"
    fieldFgColor: "{{ $c.fg }}"
  frame:
    border:
      fgColor: "{{ $c.bg_sel }}"
      focusColor: "{{ $c.accent }}"
    menu:
      fgColor: "{{ $c.fg }}"
      keyColor: "{{ $c.accent }}"
      numKeyColor: "{{ $c.accent_alt }}"
    crumbs:
      fgColor: "{{ $c.bg }}"
      bgColor: "{{ $c.accent_alt }}"
      activeColor: "{{ $c.accent }}"
    status:
      newColor: "{{ $n.cyan }}"
      modifyColor: "{{ $n.blue }}"
      addColor: "{{ $n.green }}"
      errorColor: "{{ $n.red }}"
      highlightColor: "{{ $n.yellow }}"
      killColor: "{{ $c.fg_dim }}"
      completedColor: "{{ $c.fg_dim }}"
    title:
      fgColor: "{{ $c.fg }}"
      bgColor: default
      highlightColor: "{{ $c.accent }}"
      counterColor: "{{ $c.accent_alt }}"
      filterColor: "{{ $n.green }}"
  views:
    charts:
      bgColor: default
      defaultDialColors: ["{{ $c.accent }}", "{{ $n.red }}"]
      defaultChartColors: ["{{ $c.accent }}", "{{ $n.red }}"]
    table:
      fgColor: "{{ $c.fg }}"
      bgColor: default
      cursorFgColor: "{{ $c.fg }}"
      cursorBgColor: "{{ $c.bg_sel }}"
      markColor: "{{ $n.yellow }}"
      header:
        fgColor: "{{ $c.accent }}"
        bgColor: default
        sorterColor: "{{ $n.cyan }}"
    xray:
      fgColor: "{{ $c.fg }}"
      bgColor: default
      cursorColor: "{{ $c.bg_sel }}"
      graphicColor: "{{ $c.accent_alt }}"
      showIcons: false
    yaml:
      keyColor: "{{ $c.accent }}"
      colonColor: "{{ $c.fg_dim }}"
      valueColor: "{{ $c.fg }}"
    logs:
      fgColor: "{{ $c.fg }}"
      bgColor: default
      indicator:
        fgColor: "{{ $c.fg }}"
        bgColor: "{{ $c.bg_sel }}"
