{{- $t := index .themes .theme -}}
{{- $c := $t.colors -}}
"$schema" = "https://starship.rs/config-schema.json"
# Theme: {{ $t.title }} (generated; change with `theme set <name>`)
palette = "dotfiles"

add_newline = false
command_timeout = 1000

format = """
$hostname$container$directory$git_branch$git_state$git_status$kubernetes\
$nodejs$python$java$clojure$cmd_duration
$character"""

[character]
success_symbol = "[❯](bold accent)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold accent_alt)"

[directory]
truncation_length = 4
truncate_to_repo = true
style = "bold accent"

[hostname]
ssh_only = true
format = "[$hostname]($style) "

[container]
format = "[⬢ $name]($style) "

[git_branch]
format = "[$symbol$branch]($style) "
style = "bold accent_alt"

[git_status]
format = "([$all_status$ahead_behind]($style) )"

[kubernetes]
disabled = false
format = "[⎈ $context(/$namespace)]($style) "

[cmd_duration]
min_time = 2000
style = "muted"
format = "[took $duration]($style) "

[nodejs]
format = "[$symbol($version)]($style) "

[python]
format = "[$symbol$pyenv_prefix($version)( \\($virtualenv\\))]($style) "

[java]
format = "[$symbol($version)]($style) "

[palettes.dotfiles]
accent = "{{ $c.accent }}"
accent_alt = "{{ $c.accent_alt }}"
muted = "{{ $c.fg_dim }}"
{{- range $name := list "black" "red" "green" "yellow" "blue" "cyan" "white" }}
{{ $name }} = "{{ index $c.normal $name }}"
{{- end }}
purple = "{{ $c.normal.magenta }}"
