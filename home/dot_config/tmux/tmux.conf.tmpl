# tmux config, ported from the old dotfiles.
{{- $t := index .themes .theme }}
{{- $c := $t.colors }}

# True colour + undercurl in modern terminals
set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB"
set -g escape-time 10
set -g focus-events on
set -g mouse on
set -g history-limit 50000

# Prefix C-Space
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

bind r source-file ~/.config/tmux/tmux.conf \; display "tmux.conf reloaded"

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Copy mode: vi keys, yank to system clipboard via OSC 52
# (works on macOS, WSL, over SSH and inside containers)
set -g set-clipboard on
setw -g mode-keys vi
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel

# Splits keep the current path
bind v split-window -h -c "#{pane_current_path}"
bind s split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r H resize-pane -L 5
bind -r L resize-pane -R 5
bind -r M-j resize-pane -D
bind -r M-k resize-pane -U
bind -r M-h resize-pane -L
bind -r M-l resize-pane -R

bind -r ^ last-window
bind -r k select-pane -U
bind -r j select-pane -D
bind -r h select-pane -L
bind -r l select-pane -R

# Theme: {{ $t.title }} (generated; change with `theme set <name>`)
set -g status-style "bg={{ $c.bg_alt }},fg={{ $c.fg }}"
set -g status-left-style "fg={{ $c.accent }},bold"
set -g status-right-style "fg={{ $c.fg_dim }}"
setw -g window-status-style "fg={{ $c.fg_dim }}"
setw -g window-status-current-style "fg={{ $c.accent }},bold"
set -g pane-border-style "fg={{ $c.bg_sel }}"
set -g pane-active-border-style "fg={{ $c.accent }}"
set -g message-style "bg={{ $c.bg_sel }},fg={{ $c.fg }}"
set -g mode-style "bg={{ $c.bg_sel }},fg={{ $c.fg }}"

# Plugins (tpm is installed by chezmoi; press prefix + I once to install the rest)
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @resurrect-capture-pane-contents 'on'

set-environment -g TMUX_PLUGIN_MANAGER_PATH "~/.config/tmux/plugins"
run '~/.config/tmux/plugins/tpm/tpm'
