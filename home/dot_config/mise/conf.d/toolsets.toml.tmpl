{{- /* Host-wide toolsets chosen at `chezmoi init` (data: hostToolsets). */ -}}
{{- $tools := dict -}}
{{- range $name := .hostToolsets -}}
{{-   if not (hasKey $.toolsets $name) -}}
{{-     fail (printf "unknown toolset %q (known: %s)" $name (keys $.toolsets | sortAlpha | join ", ")) -}}
{{-   end -}}
{{-   range $spec := index $.toolsets $name -}}
{{-     $parts := splitList "@" $spec -}}
{{-     $_ := set $tools (first $parts) (last $parts) -}}
{{-   end -}}
{{- end -}}
# Generated by chezmoi from hostToolsets = {{ .hostToolsets | toJson }}. Change with `chezmoi init --prompt`.
[tools]
{{- range $tool := keys $tools | sortAlpha }}
{{ $tool }} = {{ index $tools $tool | quote }}
{{- end }}
