#!/usr/bin/env bash
# devbox-init - entrypoint of the devbox image.
# Installs the project's tools (mise.toml / .tool-versions in the working directory)
# into the persistent mise volume if any are missing, then runs the command via mise.
set -uo pipefail

mise trust --all --quiet 2>/dev/null || true
if [[ -n "$(mise ls --missing --quiet 2>/dev/null)" ]] && ! mise install --yes; then
  echo "devbox-init: 'mise install' failed; continuing without the missing tools" >&2
fi

(( $# )) || set -- zsh -l
exec mise exec -- "$@"
