#!/usr/bin/env bash
# devbox - open the current directory inside the personal dev container.
#
#   devbox            interactive zsh with ./ mounted at /workspace
#   devbox <cmd...>   run a command instead (through the project's mise tools)
#   devbox build      (re)build the image locally from the dotfiles source
#                     (--pull also refreshes the Debian base image)
#   devbox -- <cmd>   run a command literally named `build` etc.
#
# The image is built locally (no registry) from ~/.local/share/chezmoi, the
# dotfiles checkout chezmoi applies from. It is built automatically on first use
# and rebuilt by `chezmoi update` when the files it is made of change.
#
# The project's tools come from its mise.toml (see `toolset add ...`) and are
# installed on first use into the shared `devbox-mise` volume.
#
# Env:
#   DEVBOX_ENGINE  podman | docker (default: podman if installed, else docker)
#   DEVBOX_IMAGE   image name (default localhost/devbox:latest)
#   DEVBOX_SOURCE  dotfiles checkout to build from (default: `chezmoi source-path`)
#   DEVBOX_DOCKER  =1 to expose the host engine's API socket in the container
#   DEVBOX_ARGS    extra run arguments, e.g. DEVBOX_ARGS="-p 3000:3000"
set -euo pipefail

engine="${DEVBOX_ENGINE:-}"
if [[ -z "$engine" ]]; then
  if command -v podman >/dev/null; then engine=podman
  elif command -v docker >/dev/null; then engine=docker
  else echo "devbox: neither podman nor docker found" >&2; exit 1
  fi
fi
command -v "$engine" >/dev/null || { echo "devbox: '$engine' not found" >&2; exit 1; }

image="${DEVBOX_IMAGE:-localhost/devbox:latest}"

build_image() {
  local src="${DEVBOX_SOURCE:-}"
  if [[ -z "$src" ]]; then
    src="$(chezmoi source-path 2>/dev/null)" || src="$HOME/.local/share/chezmoi/home"
    src="${src%/home}"   # .chezmoiroot = home; the Dockerfile lives next to it
  fi
  [[ -f "$src/container/Dockerfile" ]] || { echo "devbox: no container/Dockerfile in $src (set DEVBOX_SOURCE)" >&2; exit 1; }

  local build_args=(-f "$src/container/Dockerfile" -t "$image")
  [[ "${1:-}" == --pull ]] && build_args+=(--pull)

  # Optional GitHub token avoids API rate limits while mise downloads tools
  local token="${GITHUB_TOKEN:-}"
  [[ -z "$token" ]] && command -v gh >/dev/null && token="$(gh auth token 2>/dev/null || true)"
  [[ -n "$token" ]] && build_args+=(--secret "id=github_token,env=GITHUB_TOKEN")

  echo "==> $engine build -t $image $src"
  GITHUB_TOKEN="$token" DOCKER_BUILDKIT=1 "$engine" build "${build_args[@]}" "$src"
}

case "${1:-}" in
  build)
    shift
    build_image "$@"
    exit 0
    ;;
  --)
    shift
    ;;
esac

if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
  echo "devbox: image $image not found, building it (one-time, a couple of minutes)" >&2
  build_image
fi

project="$(basename "$PWD" | tr -c 'a-zA-Z0-9_.\n-' '-')"
args=(
  --rm --interactive
  --hostname "devbox-$project"
  --volume "$PWD:/workspace"
  --workdir /workspace
  --volume devbox-mise:/home/dev/.local/share/mise     # project tools (shared by all projects)
  --volume devbox-nvim:/home/dev/.local/share/nvim     # Lazy plugins, mason LSPs
  --volume devbox-history:/home/dev/.local/state/zsh   # shell history
  --env TERM="${TERM:-xterm-256color}"
  --env COLORTERM="${COLORTERM:-truecolor}"
)
[[ -t 0 && -t 1 ]] && args+=(--tty)

if [[ "$engine" == podman ]]; then
  # Rootless: map the host user to the image's `dev` user, so files in
  # /workspace keep the host user's ownership.
  args+=("--userns=keep-id:uid=1000,gid=1000")
fi

# Git identity from the host
if name="$(git config --get user.name)"; then
  args+=(--env "GIT_AUTHOR_NAME=$name" --env "GIT_COMMITTER_NAME=$name")
fi
if email="$(git config --get user.email)"; then
  args+=(--env "GIT_AUTHOR_EMAIL=$email" --env "GIT_COMMITTER_EMAIL=$email")
fi

# SSH agent forwarding
if [[ "$(uname -s)" == Darwin ]]; then
  if [[ "$engine" == docker ]]; then
    # OrbStack / Docker Desktop expose the host agent through a magic socket
    args+=(--volume /run/host-services/ssh-auth.sock:/run/ssh-agent.sock --env SSH_AUTH_SOCK=/run/ssh-agent.sock)
  fi
  # Podman machine cannot forward macOS sockets: use HTTPS + `gh auth login` inside.
elif [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
  args+=(--volume "$SSH_AUTH_SOCK:/run/ssh-agent.sock" --env SSH_AUTH_SOCK=/run/ssh-agent.sock)
fi

# Host container API inside the box (Testcontainers etc.)
if [[ "${DEVBOX_DOCKER:-0}" == 1 ]]; then
  if [[ "$engine" == podman ]]; then
    # Path as seen by the engine (inside the VM on macOS)
    sock="$(podman info --format '{{.Host.RemoteSocket.Path}}')"
    sock="${sock#unix://}"
    args+=(--security-opt label=disable --env TESTCONTAINERS_RYUK_CONTAINER_PRIVILEGED=true)
  else
    sock=/var/run/docker.sock
    [[ "$(uname -s)" == Linux ]] && args+=(--group-add "$(stat -c %g "$sock")")
  fi
  args+=(--volume "$sock:/var/run/docker.sock" --env DOCKER_HOST=unix:///var/run/docker.sock)
fi

if [[ -n "${DEVBOX_ARGS:-}" ]]; then
  read -r -a extra <<< "$DEVBOX_ARGS"
  args+=("${extra[@]}")
fi

exec "$engine" run "${args[@]}" "$image" "$@"
