#!/usr/bin/env bash
# Inputs: {{ include "dot_config/mise/config.toml" | sha256sum }} {{ .hostToolsets | toJson }} {{ .containerEngine }}
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

{{ if .isContainer -}}
{{ template "as-root.sh" . }}
# Containers: base tools go to the system-wide dir (/usr/local/share/mise/installs), so a
# persistent volume on ~/.local/share/mise (project tools) never hides them and a new
# image always brings fresh base tools.
if can_root; then
  echo "==> mise install --system (base tools)"
  sys=(env HOME=/root MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml" "$(command -v mise)")
  as_root "${sys[@]}" install --system --yes
  as_root "${sys[@]}" reshim --system
fi
{{ end -}}

# Everything not installed system-wide (hosts: all; containers: host toolsets, if any)
echo "==> mise install"
mise install --yes
mise reshim
