#!/usr/bin/env bash
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# host toolsets: {{ .hostToolsets | quote }}
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
{{ if .isContainer -}}
mise_bin="$(command -v mise)"
# Containers: base tools go to the system-wide dir (/usr/local/share/mise/installs) so
# that a persistent volume on ~/.local/share/mise (project tools) never hides them and
# a new image always brings fresh base tools.
if [[ $(id -u) -eq 0 ]] || sudo -n true 2>/dev/null; then
  as_root=(env)
  [[ $(id -u) -ne 0 ]] && as_root=(sudo "--preserve-env=GITHUB_TOKEN,HTTPS_PROXY,HTTP_PROXY,https_proxy,http_proxy,NO_PROXY,no_proxy,SSL_CERT_FILE" env)
  sys_env=(HOME=/root MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml")
  echo "==> mise install --system (base tools)"
  "${as_root[@]}" "${sys_env[@]}" "$mise_bin" install --system --yes
  "${as_root[@]}" "${sys_env[@]}" "$mise_bin" reshim --system
fi
{{- end }}

# Anything not installed system-wide (hosts: everything; containers: host toolsets, if any)
echo "==> mise install"
mise install --yes
mise reshim
