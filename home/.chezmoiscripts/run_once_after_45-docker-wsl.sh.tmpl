{{ if .isWSL -}}
#!/usr/bin/env bash
# Docker Engine directly inside WSL (no Docker Desktop needed). Requires systemd in WSL
# (default on current Ubuntu WSL images; see /etc/wsl.conf [boot] systemd=true).
set -euo pipefail
if ! command -v docker >/dev/null; then
  echo "==> Installing Docker Engine"
  curl -fsSL https://get.docker.com | sudo sh
fi
if ! id -nG "$USER" | grep -qw docker; then
  sudo usermod -aG docker "$USER"
  echo "==> Added $USER to the docker group (restart WSL: 'wsl --shutdown' in Windows)"
fi
{{ end -}}
