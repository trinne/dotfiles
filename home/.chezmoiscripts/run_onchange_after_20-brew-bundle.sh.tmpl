{{ if .isMac -}}
#!/usr/bin/env bash
# Brewfile hash: {{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . | sha256sum }}
set -euo pipefail
{{ template "brew-env.sh" . }}
{{- if .isCI }}
echo "==> CI: skipping brew bundle"
exit 0
{{- end }}
echo "==> brew bundle"
brew bundle --file="$HOME/.config/homebrew/Brewfile"
{{ end -}}
