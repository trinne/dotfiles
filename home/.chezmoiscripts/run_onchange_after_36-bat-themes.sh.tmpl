#!/usr/bin/env bash
# Rebuild bat's theme cache when the theme list changes: {{ include ".chezmoidata/themes.toml" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/share/mise/shims:$HOME/.local/share/mise/shims:$PATH"
if command -v bat >/dev/null; then
  echo "==> bat cache --build"
  bat cache --build >/dev/null
fi
