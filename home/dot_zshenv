# Sourced by every zsh (login, interactive and scripts). Keep it light.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

export EDITOR="nvim"
export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"
export PAGER="less"
export LESS="-R -F -i"

typeset -U path PATH
path=("$HOME/.local/bin" $path)

# Non-interactive shells (IDEs, `docker exec`, scripts) see mise tools via shims.
# Interactive shells replace this with `mise activate` in .zshrc.
[[ -d "$XDG_DATA_HOME/mise/shims" ]] && path=("$XDG_DATA_HOME/mise/shims" $path)
export PATH
