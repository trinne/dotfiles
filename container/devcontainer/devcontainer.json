// Template: copy to <project>/.devcontainer/devcontainer.json
// Works with VS Code Dev Containers, JetBrains Gateway and the `devcontainer` CLI.
// Podman users: set VS Code setting "dev.containers.dockerPath": "podman".
{
  "name": "${localWorkspaceFolderBasename}",
  "image": "ghcr.io/trinne/devbox:latest",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "mounts": [
    "source=devbox-mise,target=/home/dev/.local/share/mise,type=volume",
    "source=devbox-nvim,target=/home/dev/.local/share/nvim,type=volume",
    "source=devbox-history,target=/home/dev/.local/state/zsh,type=volume"
  ],

  // Project tools from its mise.toml / .tool-versions (add them with `toolset add ...`)
  "postCreateCommand": "mise trust --all --quiet; mise install --yes",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": { "zsh": { "path": "/bin/zsh", "args": ["-l"] } }
      }
    }
  }
}
